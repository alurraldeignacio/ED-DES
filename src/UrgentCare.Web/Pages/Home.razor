@page "/"
@implements IDisposable
@using System.Diagnostics
@using UrgentCare.Core.Distributions
@using UrgentCare.Web.Components
@using UrgentCare.Web.Session
@inject BundledScenarios Scenarios
@inject IDistributionFactory DistributionFactory

<PageTitle>Urgent Care Simulator</PageTitle>

<div class="page">
    <header class="page-header">
        <h1>Urgent Care Simulator</h1>
        <span class="clock">@ClockText(_session.DisplayTime)</span>
        <span class="status">
            @_session.Scenario.Name scenario, seed @_session.Seed
            @if (_session.PlaybackState == PlaybackState.Complete)
            {
                <text> · run complete</text>
            }
        </span>
    </header>

    <ControlBar State="_session.PlaybackState" Speed="_session.Speed"
                Scenarios="Scenarios.All" ScenarioName="@_session.Scenario.Name" Seed="_session.Seed"
                SeedError="@_seedError"
                OnTogglePlay="TogglePlay" OnStep="Step" OnSpeedChanged="ChangeSpeed"
                OnJumpToEnd="JumpToEnd" OnRestart="Restart"
                OnScenarioChanged="ChangeScenario" OnSeedApplied="ApplySeed" />

    <div class="workspace">
        <DepartmentView Snapshot="_snapshot" />
        <MetricsPanel Snapshot="_snapshot" Config="_session.Scenario.Config"
                      IsComplete="@(_session.PlaybackState == PlaybackState.Complete)" />
    </div>

    <div class="legend">
        <span>Urgency (ESI):</span>
        @for (var esi = 1; esi <= 5; esi++)
        {
            <span><span class="swatch esi-@esi @(esi <= 2 ? "acute" : null)">@esi</span>@EsiName(esi)</span>
        }
    </div>
</div>

@code {
    /// <summary>About 20 frames a second (research.md §10).</summary>
    private static readonly TimeSpan FrameInterval = TimeSpan.FromMilliseconds(50);

    private VisualSession _session = default!;
    private DepartmentSnapshot _snapshot = default!;
    private CancellationTokenSource? _frames;
    private string? _seedError;

    protected override void OnInitialized()
    {
        var scenario = Scenarios.All[0];
        StartSession(scenario, scenario.Config.Seed);
    }

    /// <summary>A new scenario or seed is a new run, starting Idle; the chosen speed carries over.</summary>
    private void StartSession(BundledScenario scenario, int seed)
    {
        StopFrames();
        var speed = _session?.Speed;
        _session = new VisualSession(scenario, seed, DistributionFactory);
        if (speed is { } kept)
        {
            _session.Speed = kept;
        }

        _snapshot = _session.Snapshot();
    }

    // Each scenario starts from its own configured seed.
    private void ChangeScenario(string name)
    {
        var scenario = Scenarios.All.FirstOrDefault(s => s.Name == name);
        if (scenario is not null)
        {
            _seedError = null;
            StartSession(scenario, scenario.Config.Seed);
        }
    }

    private void ApplySeed(string text)
    {
        if (!SeedInput.TryParse(text, out var seed, out _seedError))
        {
            return; // keep the current run and seed (spec edge case)
        }

        StartSession(_session.Scenario, seed);
    }

    private void TogglePlay()
    {
        if (_session.PlaybackState == PlaybackState.Playing)
        {
            _session.Pause();
            StopFrames();
            return;
        }

        _session.Play();
        if (_session.PlaybackState == PlaybackState.Playing)
        {
            _ = RunFramesAsync();
        }
    }

    private void Step()
    {
        StopFrames();
        _session.Step();
        _snapshot = _session.Snapshot();
    }

    // Takes effect on the next frame; the run itself is untouched (FR-010).
    private void ChangeSpeed(double speed) => _session.Speed = speed;

    private void JumpToEnd()
    {
        StopFrames();
        _session.JumpToEnd();
        _snapshot = _session.Snapshot();
    }

    private void Restart()
    {
        StopFrames();
        _session.Restart();
        _snapshot = _session.Snapshot();
    }

    /// <summary>
    /// Advances the session by the real time since the previous frame, then redraws. WebAssembly
    /// runs on one thread, so the loop and the buttons never touch the session concurrently.
    /// </summary>
    private async Task RunFramesAsync()
    {
        StopFrames();
        _frames = new CancellationTokenSource();
        var token = _frames.Token;

        using var timer = new PeriodicTimer(FrameInterval);
        var sinceLastFrame = Stopwatch.StartNew();

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                _session.Advance(sinceLastFrame.Elapsed.TotalSeconds);
                sinceLastFrame.Restart();

                _snapshot = _session.Snapshot();
                StateHasChanged();

                if (_session.PlaybackState != PlaybackState.Playing)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Paused or navigated away.
        }
    }

    private void StopFrames()
    {
        _frames?.Cancel();
        _frames?.Dispose();
        _frames = null;
    }

    public void Dispose() => StopFrames();

    private static string ClockText(double minutes)
    {
        var day = (int)(minutes / 1440.0) + 1;
        var ofDay = TimeSpan.FromMinutes(minutes % 1440.0);
        return $"Day {day}, {ofDay.Hours:00}:{ofDay.Minutes:00}";
    }

    private static string EsiName(int esi) => esi switch
    {
        1 => "resuscitation",
        2 => "emergent",
        3 => "urgent",
        4 => "less urgent",
        _ => "non-urgent"
    };
}
