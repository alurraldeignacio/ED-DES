@using System.Globalization
@using UrgentCare.Web.Session

@* Playback, scenario and seed controls. The bar only raises callbacks; the page owns the
   session (FR-003, FR-004, FR-009). *@
<div class="controls">
    <button class="primary" @onclick="OnTogglePlay" disabled="@IsComplete">
        @(State == PlaybackState.Playing ? "Pause" : "Play")
    </button>
    <button @onclick="OnStep" disabled="@IsComplete" title="Process exactly one simulation event">Step</button>

    <label class="speed">
        Speed
        <select value="@SpeedValue(Speed)" @onchange="ChangeSpeed">
            @foreach (var preset in VisualSession.SpeedPresets)
            {
                <option value="@SpeedValue(preset)">@SpeedValue(preset) min/s</option>
            }
        </select>
    </label>

    <button @onclick="OnJumpToEnd" disabled="@IsComplete">Jump to end</button>
    <button @onclick="OnRestart">Restart</button>

    <span class="divider"></span>

    <label>
        Scenario
        <select value="@ScenarioName" @onchange="ChangeScenario">
            @foreach (var scenario in Scenarios)
            {
                <option value="@scenario.Name">@scenario.Name</option>
            }
        </select>
    </label>

    <label>
        Seed
        <input class="seed" @bind="_seedText" @bind:event="oninput" @onkeydown="SeedKey" aria-invalid="@(SeedError is not null)" />
    </label>
    <button @onclick="ApplySeed">Apply</button>
</div>
@if (SeedError is not null)
{
    <p class="error" role="alert">@SeedError</p>
}

@code {
    [Parameter, EditorRequired] public PlaybackState State { get; set; }

    [Parameter, EditorRequired] public double Speed { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<BundledScenario> Scenarios { get; set; } = [];

    [Parameter, EditorRequired] public string ScenarioName { get; set; } = "";

    [Parameter, EditorRequired] public int Seed { get; set; }

    [Parameter] public string? SeedError { get; set; }

    [Parameter] public EventCallback OnTogglePlay { get; set; }

    [Parameter] public EventCallback OnStep { get; set; }

    [Parameter] public EventCallback<double> OnSpeedChanged { get; set; }

    [Parameter] public EventCallback OnJumpToEnd { get; set; }

    [Parameter] public EventCallback OnRestart { get; set; }

    [Parameter] public EventCallback<string> OnScenarioChanged { get; set; }

    /// <summary>Raised with the raw text; the page validates it and reports any error back.</summary>
    [Parameter] public EventCallback<string> OnSeedApplied { get; set; }

    private string _seedText = "";
    private int? _shownSeed;

    private bool IsComplete => State == PlaybackState.Complete;

    // Refresh the box when the session's seed changes (new scenario or applied seed), but leave
    // a rejected entry in place so the user can correct it.
    protected override void OnParametersSet()
    {
        if (_shownSeed != Seed)
        {
            _shownSeed = Seed;
            _seedText = Seed.ToString(CultureInfo.InvariantCulture);
        }
    }

    private Task ChangeSpeed(ChangeEventArgs e) =>
        double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var speed)
            ? OnSpeedChanged.InvokeAsync(speed)
            : Task.CompletedTask;

    private Task ChangeScenario(ChangeEventArgs e) => OnScenarioChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task ApplySeed() => OnSeedApplied.InvokeAsync(_seedText);

    private Task SeedKey(KeyboardEventArgs e) => e.Key == "Enter" ? ApplySeed() : Task.CompletedTask;

    private static string SpeedValue(double speed) => speed.ToString("0", CultureInfo.InvariantCulture);
}
