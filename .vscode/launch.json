{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run default scenario",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/UrgentCare.Cli/bin/Debug/net10.0/UrgentCare.Cli.dll",
      "args": ["--scenario", "default"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Run default scenario (headless)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/UrgentCare.Cli/bin/Debug/net10.0/UrgentCare.Cli.dll",
      "args": ["--scenario", "default", "--headless"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
