{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": ["restore", "UrgentCare.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "UrgentCare.sln"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "UrgentCare.sln"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "src/UrgentCare.Cli/UrgentCare.Cli.csproj",
        "--",
        "--scenario",
        "default"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "src/UrgentCare.Web/UrgentCare.Web.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
